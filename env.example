# From @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# Your Telegram user ID(s), comma separated. Get it from @userinfobot
ADMIN_IDS=123456789

# Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Use the "service_role" key (server side only, NEVER share/commit it)
SUPABASE_SERVICE_KEY=your-service-role-key

# Broadcast speed (messages/second). Telegram's global limit is ~30/s.
# 20 leaves headroom so /start replies stay instant during a broadcast.
BROADCAST_RATE=20
